import java.io.*;
import java.util.*;

public class Main {

    public static void main(String[] args) throws Exception {
        BufferedReader br =
                new BufferedReader(new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine().trim());
        String s = br.readLine().trim();

        String doubled = s + s;

        int[] answer = new int[n];

        // Manacher's algorithm
        int m = doubled.length();

        // d1[i] = radius of odd palindrome centered at i
        int[] d1 = new int[m];

        int l = 0, r = -1;

        for (int i = 0; i < m; i++) {
            int k = (i > r) ? 1 : Math.min(d1[l + r - i], r - i + 1);

            while (i - k >= 0 &&
                   i + k < m &&
                   doubled.charAt(i - k) == doubled.charAt(i + k)) {
                k++;
            }

            d1[i] = k;

            if (i + k - 1 > r) {
                l = i - k + 1;
                r = i + k - 1;
            }
        }

        // d2[i] = radius of even palindrome centered between i-1 and i
        int[] d2 = new int[m];

        l = 0;
        r = -1;

        for (int i = 0; i < m; i++) {
            int k = (i > r) ? 0 : Math.min(d2[l + r - i + 1], r - i + 1);

            while (i - k - 1 >= 0 &&
                   i + k < m &&
                   doubled.charAt(i - k - 1) == doubled.charAt(i + k)) {
                k++;
            }

            d2[i] = k;

            if (i + k - 1 > r) {
                l = i - k;
                r = i + k - 1;
            }
        }

        /*
         * For every palindrome, update the rotations whose
         * window of length n contains that palindrome.
         *
         * A rotation starting at 'start' corresponds to:
         * [start, start + n - 1] in doubled.
         */

        // Process odd-length palindromes
        for (int center = 0; center < m; center++) {
            int radius = d1[center];

            for (int k = radius; k > 0; k--) {
                int left = center - k + 1;
                int right = center + k - 1;
                int len = right - left + 1;

                if (len > n) {
                    break;
                }

                update(answer, n, left, right, len);
            }
        }

        // Process even-length palindromes
        for (int center = 0; center < m; center++) {
            int radius = d2[center];

            for (int k = radius; k > 0; k--) {
                int left = center - k;
                int right = center + k - 1;
                int len = right - left + 1;

                if (len > n) {
                    break;
                }

                update(answer, n, left, right, len);
            }
        }

        StringBuilder out = new StringBuilder();

        for (int x : answer) {
            out.append(x).append('\n');
        }

        System.out.print(out);
    }

    /*
     * Update all rotations whose length-n window contains
     * the palindrome [left, right].
     */
    static void update(int[] answer, int n,
                       int left, int right, int len) {

        int startMin = Math.max(0, right - n + 1);
        int startMax = Math.min(n - 1, left);

        for (int start = startMin; start <= startMax; start++) {
            answer[start] = Math.max(answer[start], len);
        }
    }
}
